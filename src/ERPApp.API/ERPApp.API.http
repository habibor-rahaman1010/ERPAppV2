@ERPApp.API_HostAddress = http://localhost:5224

### Login
# @name login
POST {{ERPApp.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "userName": "admin",
  "password": "your-password"
}

### Current user + permissions
GET {{ERPApp.API_HostAddress}}/api/auth/me
Authorization: Bearer {{login.response.body.$.token}}

### Refresh (rotates the refresh token)
POST {{ERPApp.API_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}

### Logout (revokes the refresh token session)
POST {{ERPApp.API_HostAddress}}/api/auth/logout
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}
